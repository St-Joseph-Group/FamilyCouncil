# Capacitor native builds. The projects themselves are committed so signing
# config and native tweaks are versioned; only build output is ignored.
android/app/build/
android/build/
android/.gradle/
android/local.properties
android/app/src/main/assets/public/
ios/App/App/public/
ios/App/Pods/
ios/App/output/
ios/App/build/

# n8n API key must never be committed. The export script reads it from the
# environment; keep any local helper script out of git.
n8n/.env
n8n/*.local.*
