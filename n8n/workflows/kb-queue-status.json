    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT file_name, mime_type, parent_folder\nFROM fc_kb_queue\nWHERE status = 'skipped'\nORDER BY file_name;",
        "options": {}
      },
      "id": "ea153cde-a632-4566-97c1-b14ab55aa17d",
