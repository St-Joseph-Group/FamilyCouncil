    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT file_name, mime_type, parent_folder,\n       to_char(updated_at AT TIME ZONE 'Asia/Manila', 'YYYY-MM-DD HH24:MI') AS last_touched_ph,\n       round(EXTRACT(EPOCH FROM (now() - updated_at)) / 60)::int AS minutes_ago\nFROM fc_kb_queue\nWHERE status = 'processing'\nORDER BY updated_at ASC;",
        "options": {}
